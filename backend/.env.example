#此处填写Google vertex AI中的API密钥
GOOGLE_CLOUD_API_KEY=你的 APIkey

#此处填写Google vertex AI中的项目ID
GOOGLE_CLOUD_PROJECT=你的项目ID

#此处填写Google vertex AI中的地区，一般默认即可
GOOGLE_CLOUD_LOCATION=us-central1

#此处填写Yunwu中的API密钥
YUNWU_API_KEY=你的 APIkey

#此处填写Yunwu中的base_url,一般默认即可
YUNWU_BASE_URL=https://yunwu.ai

#此处填写Yunwu Kling中的路径，默认即可
YUNWU_KLING_PATH_PREFIX=/kling

#此处填写Deepseek中的API密钥
DEEPSEEK_API_KEY=你的 APIkey

#以下是Kling官方API信息，仅替换ACCESS_KEY、SECRET_KEY即可
KLING_ACCESS_KEY=你的 AccessKey

KLING_SECRET_KEY=你的 SecretKey

KLING_API_BASE=https://api-beijing.klingai.com


#此处填写Seedance API密钥
ARK_API_KEY=

ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Public asset storage: r2 or tos
PUBLIC_ASSET_STORAGE=r2
PUBLIC_ASSET_RETENTION_DAYS=5
PUBLIC_ASSET_CACHE_TTL_DAYS=4
PUBLIC_ASSET_PREFIX=node-canvas/seedance-input/

# Cloudflare R2 API
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=node-canvas-seedance
CLOUDFLARE_R2_PUBLIC_DOMAIN=
CLOUDFLARE_R2_ENDPOINT=

# Volcengine TOS
VOLCENGINE_TOS_ACCESS_KEY_ID=
VOLCENGINE_TOS_SECRET_ACCESS_KEY=
VOLCENGINE_TOS_BUCKET_NAME=
VOLCENGINE_TOS_REGION=cn-beijing
VOLCENGINE_TOS_ENDPOINT=tos-cn-beijing.volces.com
VOLCENGINE_TOS_PUBLIC_DOMAIN=

#图片/音频base64限制
SEEDANCE_IMAGE_TRANSFER=base64-first
SEEDANCE_IMAGE_BASE64_MAX_MB=10
SEEDANCE_IMAGE_BASE64_TOTAL_MAX_MB=40

SEEDANCE_AUDIO_TRANSFER=base64-first
SEEDANCE_AUDIO_BASE64_MAX_MB=15
